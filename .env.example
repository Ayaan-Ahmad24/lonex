# LONEX CMS — server environment
# Copy this file to .env.local and replace every placeholder.
# Never commit real secrets.

# MySQL 8 connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lonex_dev_user
MYSQL_PASSWORD=replace-with-local-password
MYSQL_DATABASE=lonex_dev

# Better Auth
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional trusted reverse proxies (comma-separated IPs or CIDR ranges).
# Leave empty for direct hosting. In production, an empty value means
# forwarded IP headers are ignored and rate limiting uses one shared bucket.
# Example: TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10
TRUSTED_PROXIES=

# Optional: force HSTS when the deployment is HTTPS but BETTER_AUTH_URL is not
# set to an https:// URL. 0 or 1.
ENABLE_HSTS=0

# Private media storage. MUST be outside public/, .next/ and node_modules/.
# Default is .data/media. A production deployment must point this at a
# persistent directory outside the release tree; local development only.
MEDIA_STORAGE_PATH=.data/media

# Maximum upload size in bytes (1 KiB - 50 MiB). Default 5 MiB.
MEDIA_MAX_UPLOAD_BYTES=5242880
