# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/tests/e2e/.fixtures.json

# private media storage (never commit uploaded files)
/.data/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local workspace notes and source handoff (not part of the app)
/.kilo/
/reference/
/claude bakwas.md
/LONEX_AUDIT_FOR_CHATGPT.md
/final logo.png

# local server logs and QA captures
/.dev-*.log
/.prod-server*.log
/test-artifacts/
